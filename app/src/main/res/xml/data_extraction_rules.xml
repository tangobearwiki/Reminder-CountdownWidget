<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="reminder_database" />
        <exclude domain="database" path="reminder_database-shm" />
        <exclude domain="database" path="reminder_database-wal" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="backup_preferences.xml" />
        <exclude domain="sharedpref" path="security_preferences.xml" />
        <exclude domain="sharedpref" path="theme_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="security_preferences.xml" />
        <exclude domain="sharedpref" path="backup_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
