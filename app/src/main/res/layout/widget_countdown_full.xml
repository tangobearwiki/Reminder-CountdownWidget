<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_countdown_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@android:color/transparent" />

    <View
        android:id="@+id/widget_countdown_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BB0D0D1A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="18dp">

        <!-- Accent bar -->
        <TextView
            android:id="@+id/widget_countdown_accent_bar"
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:background="#76E4F7"
            android:text="" />

        <TextView
            android:id="@+id/widget_countdown_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="事件" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/widget_countdown_days_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="56sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:text="0" />
            <TextView
                android:id="@+id/widget_countdown_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B0B0C8"
                android:textSize="14sp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="天" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_countdown_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CAD5E2"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:text="days left" />

        <TextView
            android:id="@+id/widget_countdown_target_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#93A4B8"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="——" />

        <TextView
            android:id="@+id/widget_countdown_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#DDE7F4"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            android:text="" />

        <TextView
            android:id="@+id/widget_countdown_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CAD5E2"
            android:textSize="11sp"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            android:text="" />
    </LinearLayout>
</FrameLayout>