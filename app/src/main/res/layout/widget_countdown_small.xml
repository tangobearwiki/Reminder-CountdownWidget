<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_countdown_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@android:color/transparent" />

    <View
        android:id="@+id/widget_countdown_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0D0D1A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_countdown_days_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:text="0" />

        <TextView
            android:id="@+id/widget_countdown_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0B0C8"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:text="天" />
    </LinearLayout>
</FrameLayout>