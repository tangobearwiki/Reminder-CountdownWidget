<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_countdown_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@android:color/transparent" />

    <View
        android:id="@+id/widget_countdown_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0D0D1A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:id="@+id/widget_countdown_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E0E0F0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="事件" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/widget_countdown_days_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="44sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:text="0" />
            <TextView
                android:id="@+id/widget_countdown_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B0B0C8"
                android:textSize="12sp"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="4dp"
                android:text="天" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_countdown_target_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8888AA"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="——" />
    </LinearLayout>
</FrameLayout>